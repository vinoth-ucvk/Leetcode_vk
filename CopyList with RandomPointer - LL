class Solution {
    public Node copyRandomList(Node head) {
        Node temp=head;
         //1 create copy in between
        while(temp!=null){
            Node newnode=new Node(temp.val);
            newnode.next=temp.next;
            temp.next=newnode;
            temp=temp.next.next;
        }
        temp=head;
        //2 map random node in copy
        while(temp!=null){
            Node newnode=temp.next;
            if(temp.random!=null)newnode.random=temp.random.next;
            temp=temp.next.next;
        }
        //3 map copy node to next and retrive original node connection
        temp=head;
        Node dummy=new Node(-1);
        Node res=dummy;
        while(temp!=null){
            res.next=temp.next;
            if(temp.next.next!=null)temp.next=temp.next.next;
            else temp.next=null;
            res=res.next;
            temp=temp.next;

        }
        return dummy.next;
        
    }
}
